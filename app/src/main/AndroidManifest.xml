<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        M2 permission set + the M2.5 embedded-ADB bridge + the M3 (v0.3.3)
        capture and update-checker permissions. Every permission is requested
        in context and can be declined — the related feature simply stays off
        (see PRIVACY.md). The projection consent dialog arrives with VoIP
        capture (next M3 step).
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v0.2.6: restart the 24×7 call watcher after a reboot (only when the
         user opted in during onboarding). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        M3 capture engine (v0.3.3): the in-process AudioRecord path (probe,
        mic fallback, diagnostics) records through the microphone. REQUESTED
        IN CONTEXT — probing/recording without it simply falls to an error,
        nothing else in the app needs audio.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
        Update checker (v0.3.3): the per-app "Install unknown apps" grant is
        requested at the moment the user taps Update — oneCR downloads the
        release APK from GitHub and hands it to the system installer. No
        other use; see PRIVACY.md.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Embedded ADB bridge (M2.5): local TCP sockets to this phone's own adbd
        (wireless debugging TLS). Never used for any network/cloud traffic —
        oneCR has no servers and sends nothing off the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Package visibility (no QUERY_ALL_PACKAGES): only the Shizuku bridge and the
        fixed VoIP allowlist are visible to package queries.
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.orca" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.viber.voip" />
        <package android:name="com.skype.raider" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.discord" />
    </queries>

    <application
        android:name=".OneCRApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.oneCR">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Shizuku API initialization — required by dev.rikka.shizuku:api
            (the AAR manifest only carries the V3 meta-data, the provider entry
            itself must be declared by the app, per Shizuku's integration docs).
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            Detection foreground service (M2). specialUse with an honest sub-type;
            the microphone/mediaProjection-typed recorder service replaces this in M3.

            v0.2.6: stopWithTask=false is explicit — closing/swiping the app away
            never stops the watcher; onTaskRemoved re-asserts its notification and
            BootReceiver restarts it after a reboot.
        -->
        <service
            android:name="com.lmalakar.onecr.service.detection.CallDetectionService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="call_state_detection_for_user_initiated_recording" />
        </service>

        <!--
            Capture foreground service (M3 step 1, v0.3.3). microphone type so
            the platform privacy chip and notification are honest about audio
            recording; it stops itself the moment the engine returns to Idle.
        -->
        <service
            android:name="com.lmalakar.onecr.service.recorder.RecordingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

        <!--
            Update notification actions (v0.3.3): Update / Cancel buttons on
            the "new version available" notification. Not exported — only
            oneCR's own PendingIntents reach it.
        -->
        <receiver
            android:name="com.lmalakar.onecr.update.UpdateActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            Update installer bridge (v0.3.3): hands the downloaded release APK
            (app-private storage) to the system package installer via a
            content URI — no storage permissions involved.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- v0.2.6: 24×7 watcher auto-restart after boot (opt-in during onboarding). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- VoIP heuristic input (1): ongoing call notifications from allowlisted apps. -->
        <service
            android:name="com.lmalakar.onecr.service.detection.VoipNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
